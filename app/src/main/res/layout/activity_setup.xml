<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/setup_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ls_white"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="8dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/sanitized_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"
                android:layout_marginEnd="-20dp"
                android:background="@drawable/ls_preview_background"
                android:contentDescription="@string/sanitized_preview_description"
                android:minHeight="220dp">

                <LinearLayout
                    android:id="@+id/sanitized_preview_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_privacy_shield"
                        android:tint="@color/ls_teal" />

                    <TextView
                        android:id="@+id/camera_permission_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/camera_permission_denied"
                        android:textColor="@color/ls_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/sanitized_preview_waiting"
                        android:textColor="@color/ls_slate"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.liveshield.app.setup.FaceSelectionOverlayView
                    android:id="@+id/face_selection_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="yes" />

                <com.liveshield.app.setup.PrivacyZoneEditorView
                    android:id="@+id/privacy_zone_editor_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="yes"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/indoor_privacy_setup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/indoor_privacy_setup_title"
                android:textColor="@color/ls_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/face_selection_indicator"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/ls_status_circle" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ls_person"
                    android:tint="@color/ls_teal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/setup_select_face"
                    android:textColor="@color/ls_ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/face_selection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/setup_face_waiting"
                    android:textColor="@color/ls_slate"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ls_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/privacy_zone_indicator"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/ls_status_circle" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ls_crop_free"
                    android:tint="@color/ls_teal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/setup_draw_zones"
                    android:textColor="@color/ls_ink"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/toggle_zone_drawing"
                    style="@style/LiveShieldTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:text="@string/draw_privacy_zone" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ls_chevron_right"
                    android:tint="@color/ls_ink" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ls_divider" />

            <FrameLayout
                android:id="@+id/stream_destination_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ls_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ls_verified"
                    android:tint="@color/ls_teal" />

                <TextView
                    android:id="@+id/privacy_readiness_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/privacy_status_permission_required"
                    android:textColor="@color/ls_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="46dp"
                android:layout_marginTop="2dp"
                android:text="@string/setup_review_helper"
                android:textColor="@color/ls_slate"
                android:textSize="13sp" />

            <Button
                android:id="@+id/start_protected_live"
                style="@style/LiveShieldPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:enabled="false"
                android:text="@string/start_protected_live" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/scope_disclosure_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ls_white" />
</merge>
