<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/setup_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ls_white"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/sanitized_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"
                android:layout_marginEnd="-20dp"
                android:background="@drawable/ls_preview_background"
                android:contentDescription="@string/sanitized_preview_description"
                android:minHeight="220dp">

                <LinearLayout
                    android:id="@+id/sanitized_preview_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_privacy_shield"
                        android:tint="@color/ls_teal" />

                    <TextView
                        android:id="@+id/camera_permission_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/camera_permission_denied"
                        android:textColor="@color/ls_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/sanitized_preview_waiting"
                        android:textColor="@color/ls_slate"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/ls_protected_badge_background"
                    android:drawableStart="@drawable/ic_ls_verified"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/ls_white"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="@string/protected_preview"
                    android:textColor="@color/ls_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.liveshield.app.setup.FaceSelectionOverlayView
                    android:id="@+id/face_selection_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="yes" />

                <com.liveshield.app.setup.PrivacyZoneEditorView
                    android:id="@+id/privacy_zone_editor_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="yes"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/indoor_privacy_setup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/indoor_privacy_setup_title"
                android:textColor="@color/ls_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/protection_options_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ls_setup_group_background"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/face_selection_row"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/face_selection_indicator"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/ls_face_indicator_background"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:tint="@color/ls_ink" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="14dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ls_person"
                        android:tint="@color/ls_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/setup_select_face"
                        android:textColor="@color/ls_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/face_selection_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/setup_face_waiting"
                        android:textColor="@color/ls_teal_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ls_chevron_right"
                        android:tint="@color/ls_ink" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@color/ls_divider" />

                <LinearLayout
                    android:id="@+id/qr_protection_row"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <CheckBox
                        android:id="@+id/cover_qr_codes_toggle"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/ls_qr_indicator_background"
                        android:buttonTint="@color/ls_teal_dark"
                        android:checked="true"
                        android:contentDescription="@string/cover_qr_codes"
                        android:gravity="center"
                        android:padding="5dp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="14dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ls_qr_code"
                        android:tint="@color/ls_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/setup_qr_codes"
                        android:textColor="@color/ls_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/qr_protection_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_qr_on"
                        android:textColor="@color/ls_teal_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ls_chevron_right"
                        android:tint="@color/ls_ink" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@color/ls_divider" />

                <LinearLayout
                    android:id="@+id/toggle_watchlist_details"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/watchlist_indicator"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/ls_text_indicator_background"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:tint="@color/ls_ink" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="14dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ls_lock"
                        android:tint="@color/ls_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/setup_private_words"
                        android:textColor="@color/ls_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/watchlist_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_add"
                        android:textColor="@color/ls_teal_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ls_chevron_right"
                        android:tint="@color/ls_ink" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/watchlist_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/private_words_explanation"
                        android:textColor="@color/ls_slate"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/watchlist_term_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:autofillHints=""
                        android:freezesText="false"
                        android:hint="@string/private_word_hint"
                        android:importantForAutofill="noExcludeDescendants"
                        android:inputType="textNoSuggestions"
                        android:maxLength="64"
                        android:saveEnabled="false"
                        android:textColor="@color/ls_ink"
                        android:textColorHint="@color/ls_slate" />

                    <Button
                        android:id="@+id/add_watchlist_term"
                        style="@style/LiveShieldPrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/add_private_word" />

                    <TextView
                        android:id="@+id/watchlist_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/private_words_empty"
                        android:textColor="@color/ls_slate"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/watchlist_terms_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@color/ls_divider" />

                <LinearLayout
                    android:id="@+id/toggle_zone_drawing"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/privacy_zone_indicator"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/ls_zone_indicator_background"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:tint="@color/ls_ink" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="14dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ls_crop_free"
                        android:tint="@color/ls_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/setup_draw_zones"
                        android:textColor="@color/ls_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/privacy_zone_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_draw"
                        android:textColor="@color/ls_teal_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ls_chevron_right"
                        android:tint="@color/ls_ink" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/stream_destination_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ls_verified"
                    android:tint="@color/ls_teal" />

                <TextView
                    android:id="@+id/privacy_readiness_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/privacy_status_permission_required"
                    android:textColor="@color/ls_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:layout_marginTop="3dp"
                android:text="@string/setup_review_helper"
                android:textColor="@color/ls_slate"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/start_protected_live"
                style="@style/LiveShieldPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/ls_setup_primary_button"
                android:enabled="false"
                android:text="@string/start_protected_live" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/scope_disclosure_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ls_white" />
</merge>
