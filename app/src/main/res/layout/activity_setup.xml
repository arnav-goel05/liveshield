<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/setup_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_scope_notice"
            android:textColor="#FFCFD8DC"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/sanitized_preview_container"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/privacy_placeholder"
            android:contentDescription="@string/sanitized_preview_description">

            <TextView
                android:id="@+id/sanitized_preview_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawablePadding="12dp"
                android:drawableTop="@drawable/ic_privacy_shield"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/sanitized_preview_waiting"
                android:textColor="#FFE8EEF2"
                android:textSize="16sp"
                tools:ignore="UseCompatTextViewDrawableXml" />

            <com.liveshield.app.setup.FaceSelectionOverlayView
                android:id="@+id/face_selection_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="yes" />

            <com.liveshield.app.setup.PrivacyZoneEditorView
                android:id="@+id/privacy_zone_editor_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="yes"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/camera_permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/camera_permission_denied"
            android:textColor="#FFFFD180"
            android:textSize="15sp" />

        <Button
            android:id="@+id/request_camera_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/allow_camera" />

        <TextView
            android:id="@+id/privacy_readiness_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/privacy_status_permission_required"
            android:textColor="#FFE8EEF2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/host_selection_instruction"
            android:textColor="#FFCFD8DC"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/video_only_notice"
            android:textColor="#FFCFD8DC"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/privacy_limit_notice"
            android:textColor="#FFCFD8DC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/indoor_privacy_setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/indoor_privacy_setup_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/watchlist_explanation"
            android:textColor="#FFCFD8DC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/watchlist_term_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:freezesText="false"
            android:hint="@string/watchlist_term_hint"
            android:importantForAutofill="noExcludeDescendants"
            android:inputType="text"
            android:maxLength="64"
            android:saveEnabled="false"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FFB0BEC5" />

        <Button
            android:id="@+id/add_watchlist_term"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/add_watchlist_term" />

        <TextView
            android:id="@+id/watchlist_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:layout_marginTop="4dp"
            android:text="@string/watchlist_status_empty"
            android:textColor="#FFE8EEF2" />

        <LinearLayout
            android:id="@+id/watchlist_terms_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/privacy_zone_explanation"
            android:textColor="#FFCFD8DC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/toggle_zone_drawing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/draw_privacy_zone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            style="?android:attr/buttonBarStyle">

            <Button
                android:id="@+id/previous_privacy_zone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?android:attr/buttonBarButtonStyle"
                android:text="@string/previous_privacy_zone" />

            <Button
                android:id="@+id/next_privacy_zone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?android:attr/buttonBarButtonStyle"
                android:text="@string/next_privacy_zone" />

            <Button
                android:id="@+id/remove_privacy_zone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?android:attr/buttonBarButtonStyle"
                android:text="@string/remove_privacy_zone" />
        </LinearLayout>

        <TextView
            android:id="@+id/privacy_zone_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/privacy_zone_status_empty"
            android:textColor="#FFE8EEF2" />

        <Button
            android:id="@+id/confirm_privacy_zones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/confirm_privacy_zones" />

        <FrameLayout
            android:id="@+id/stream_destination_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/start_protected_live"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="@string/start_protected_live" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/scope_disclosure_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF101820" />
</merge>
