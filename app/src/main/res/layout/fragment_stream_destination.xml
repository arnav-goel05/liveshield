<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical"
    android:saveEnabled="false">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/destination_title"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/destination_video_only_explanation"
        android:textColor="#FFCFD8DC" />

    <RadioGroup
        android:id="@+id/destination_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:saveEnabled="false">

        <RadioButton
            android:id="@+id/destination_local_demo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/destination_local_demo" />

        <RadioButton
            android:id="@+id/destination_tiktok_external"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/destination_tiktok_external" />
    </RadioGroup>

    <TextView
        android:id="@+id/external_stream_eligibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/destination_tiktok_eligibility"
        android:textColor="#FFFFD180"
        android:visibility="gone" />

    <EditText
        android:id="@+id/external_stream_endpoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:hint="@string/destination_endpoint_hint"
        android:importantForAutofill="noExcludeDescendants"
        android:inputType="textUri"
        android:saveEnabled="false"
        android:visibility="gone" />

    <EditText
        android:id="@+id/external_stream_secret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:freezesText="false"
        android:hint="@string/destination_secret_hint"
        android:importantForAutofill="noExcludeDescendants"
        android:inputType="textPassword"
        android:saveEnabled="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/destination_private_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/destination_status_demo_not_configured"
        android:textColor="#FFE8EEF2" />

    <Button
        android:id="@+id/configure_stream_destination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/destination_configure" />
</LinearLayout>
