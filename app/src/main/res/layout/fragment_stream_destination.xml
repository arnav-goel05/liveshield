<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ls_setup_group_background"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical"
    android:saveEnabled="false">

    <LinearLayout
        android:id="@+id/destination_section_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/ls_qr_indicator_background"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_ls_camera"
            android:tint="@color/ls_ink" />

        <TextView
            android:id="@+id/destination_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/destination_title"
            android:textColor="@color/ls_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/destination_header_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/destination_choose"
            android:textColor="@color/ls_teal_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ls_chevron_right"
            android:tint="@color/ls_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/destination_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ls_teal_pale"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/destination_video_only_explanation"
            android:textColor="@color/ls_slate"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/destination_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:saveEnabled="false">

            <RadioButton
                android:id="@+id/destination_local_demo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ls_teal"
                android:text="@string/destination_local_demo"
                android:textColor="@color/ls_ink" />

            <RadioButton
                android:id="@+id/destination_tiktok_external"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ls_teal"
                android:text="@string/destination_tiktok_external"
                android:textColor="@color/ls_ink" />
        </RadioGroup>

        <TextView
            android:id="@+id/external_stream_eligibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/destination_tiktok_eligibility"
            android:textColor="@color/ls_warning"
            android:textSize="14sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/external_stream_endpoint"
            style="@style/LiveShieldInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:hint="@string/destination_endpoint_hint"
            android:importantForAutofill="noExcludeDescendants"
            android:inputType="textUri"
            android:saveEnabled="false"
            android:visibility="visible" />

        <EditText
            android:id="@+id/external_stream_secret"
            style="@style/LiveShieldInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:freezesText="false"
            android:hint="@string/destination_secret_hint"
            android:importantForAutofill="noExcludeDescendants"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/destination_private_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/destination_status_demo_not_configured"
            android:textColor="@color/ls_slate"
            android:textSize="14sp" />

        <Button
            android:id="@+id/configure_stream_destination"
            style="@style/LiveShieldPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/destination_configure" />
    </LinearLayout>
</LinearLayout>
