<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LiveShieldTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#FF0B0F12</item>
    </style>

    <style name="LiveShieldSetupTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/ls_white</item>
        <item name="android:colorAccent">@color/ls_teal</item>
        <item name="android:navigationBarColor">@color/ls_ink</item>
        <item name="android:statusBarColor">@color/ls_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="LiveShieldPrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ls_primary_button</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ls_primary_button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LiveShieldTextButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ls_teal_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LiveShieldInput" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/ls_input_background</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/ls_ink</item>
        <item name="android:textColorHint">@color/ls_slate</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
